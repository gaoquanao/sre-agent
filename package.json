{
  "name": "sre-agent",
  "private": true,
  "version": "0.1.0",
  "description": "SRE Agent platform: web-first, kernel-pluggable (Pi / DeepSeek Harness), with skills, MCP, models, permissions, schedules and knowledge base",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/dsh-bridge-plugin",
    "packages/web",
    "packages/desktop"
  ],
  "overrides": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2"
  },
  "scripts": {
    "build:protocol": "npm run build -w @sre/protocol",
    "build:server": "npm run build -w @sre/server",
    "build:web": "npm run build -w @sre/web",
    "build": "npm run build:protocol && npm run build:server && npm run build:web",
    "dev:server": "npm run dev -w @sre/server",
    "dev:web": "npm run dev -w @sre/web",
    "start": "node packages/server/dist/index.js",
    "test": "node --test --test-concurrency=1 \"packages/server/test/**/*.test.ts\"",
    "typecheck": "npm run typecheck -w @sre/protocol && npm run typecheck -w @sre/server",
    "desktop": "npm run dev -w @sre/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
